<?xml version="1.0" encoding="utf-8"?>
<!-- Publish fills in processPath/arguments. requestTimeout: the reader's Google voice is one
     long streamed track, which must not be cut off after ANCM's default timeout. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" requestTimeout="04:00:00" />
    </system.webServer>
  </location>
</configuration>
